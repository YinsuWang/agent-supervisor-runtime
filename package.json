{
  "name": "agent-supervisor-runtime",
  "version": "0.2.0",
  "description": "A local supervisor runtime for durable supervisor-worker agent delegation.",
  "type": "module",
  "bin": {
    "orchestrator": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:extension",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p extension/tsconfig.json --noEmit",
    "test": "vitest",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
