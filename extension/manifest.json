{
  "manifest_version": 3,
  "name": "Agent Supervisor Runtime",
  "version": "0.2.0",
  "description": "Bind an ordinary ChatGPT conversation to the local Agent Supervisor Runtime.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["dist/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Agent Supervisor Runtime",
    "default_popup": "popup.html"
  }
}
